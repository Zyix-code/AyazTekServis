@model AyazTekServis.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="page-head">
    <div>
        <div class="eyebrow">Genel Bakış</div>
        <h1>Servis Yönetim Paneli</h1>
        <p>Servis süreçlerinin güncel durumunu ve bekleyen işlemleri özet olarak görüntüleyin.</p>
    </div>
    <a asp-controller="Service" asp-action="AddService" class="btn btn-primary px-4 py-2 rounded-3 fw-bold"><i class="bi bi-plus-lg me-1"></i> Yeni Servis Kaydı</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="app-card stat-card"><div><div class="value">@Model.Total</div><div class="label">Toplam Aktif Kayıt</div></div><div class="stat-icon"><i class="bi bi-hdd-stack"></i></div></div></div>
    <div class="col-6 col-xl-3"><div class="app-card stat-card"><div><div class="value">@Model.InService</div><div class="label">Serviste</div></div><div class="stat-icon"><i class="bi bi-tools"></i></div></div></div>
    <div class="col-6 col-xl-3"><div class="app-card stat-card"><div><div class="value">@Model.Waiting</div><div class="label">Beklemede</div></div><div class="stat-icon"><i class="bi bi-hourglass-split"></i></div></div></div>
    <div class="col-6 col-xl-3"><a asp-controller="Service" asp-action="DeliveryQueue" class="text-decoration-none text-reset d-block h-100"><div class="app-card stat-card h-100 dashboard-link-card"><div><div class="value">@Model.Ready</div><div class="label">Teslime Hazır</div><small class="text-primary">Teslim ekranını aç</small></div><div class="stat-icon"><i class="bi bi-box2-heart"></i></div></div></a></div>
</div>
<section class="dashboard-alert-section mb-4" aria-label="Servis süre takibi">
    <div class="dashboard-alert-heading">
        <div><div class="section-title">Servis Süre Takibi</div><p>İlgili kartı seçerek bildirimleri ve cihaz ayrıntılarını görüntüleyin.</p></div>
        <a asp-controller="Notifications" asp-action="Index" class="dashboard-alert-all">Tüm bildirimler <i class="bi bi-arrow-up-right"></i></a>
    </div>
    <div class="row g-3 service-alert-grid">
        <div class="col-md-4"><a asp-controller="Notifications" asp-action="Index" asp-route-type="preservice" class="text-decoration-none text-reset d-block h-100" aria-label="Servise gönderilmeyi bekleyen bildirimleri görüntüle"><div class="app-card service-threshold-card threshold-info h-100"><span class="threshold-icon"><i class="bi bi-box-arrow-up-right"></i></span><div class="threshold-body"><strong>Servise Gönderilmeyi Bekleyen</strong><span><b>@ViewBag.PreService0To7</b> kayıt · 0–7 çalışma günü</span>@if((int)(ViewBag.PreServiceOverdue ?? 0)>0){<small class="text-danger fw-semibold">@ViewBag.PreServiceOverdue kayıt gönderim hedefini aştı</small>}<small class="threshold-cta">Bildirimleri görmek için tıklayın <i class="bi bi-arrow-right"></i></small></div></div></a></div>
        <div class="col-md-4"><a asp-controller="Notifications" asp-action="Index" asp-route-type="warning" class="text-decoration-none text-reset d-block h-100" aria-label="Süresi yaklaşan servis bildirimlerini görüntüle"><div class="app-card service-threshold-card threshold-warning h-100"><span class="threshold-icon"><i class="bi bi-exclamation-triangle"></i></span><div class="threshold-body"><strong>Süresi Yaklaşan</strong><span><b>@ViewBag.Warning18To19</b> kayıt · 18–19 çalışma günü</span><small class="threshold-cta">Bildirimleri görmek için tıklayın <i class="bi bi-arrow-right"></i></small></div></div></a></div>
        <div class="col-md-4"><a asp-controller="Notifications" asp-action="Index" asp-route-type="danger" class="text-decoration-none text-reset d-block h-100" aria-label="Süresi dolan servis bildirimlerini görüntüle"><div class="app-card service-threshold-card threshold-danger h-100"><span class="threshold-icon"><i class="bi bi-exclamation-octagon"></i></span><div class="threshold-body"><strong>Süresi Dolan / Aşılan</strong><span><b>@ViewBag.Overdue20</b> kayıt · 20+ çalışma günü</span><small class="threshold-cta">Bildirimleri görmek için tıklayın <i class="bi bi-arrow-right"></i></small></div></div></a></div>
    </div>
</section>
<div class="row g-4">
    <div class="col-xl-8">
        <div class="app-card overflow-hidden">
            <div class="card-pad d-flex justify-content-between align-items-center"><div><div class="section-title">Son Servis Kayıtları</div></div><a asp-controller="Service" asp-action="Index" class="btn btn-sm btn-outline-primary">Tümünü Gör</a></div>
            <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th class="ps-4">Servis No</th><th>Gönderen</th><th>Ürün</th><th>Durum</th><th class="text-end pe-4">İşlem</th></tr></thead><tbody>
            @if (!Model.Recent.Any()) { <tr><td colspan="5" class="text-center text-muted py-5">Henüz servis kaydı yok.</td></tr> }
            @foreach (var r in Model.Recent) {
                <tr><td class="ps-4"><strong>@r.TrackingNumber</strong><small class="d-block text-muted">@r.CreatedAt.ToString("dd.MM.yyyy")</small></td><td>@r.Sender</td><td><strong>@r.Brand @r.Model</strong><small class="d-block text-muted">@r.SerialNumber</small></td><td><span class="badge text-bg-light">@r.Status</span></td><td class="text-end pe-4"><a asp-controller="Service" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-right"></i></a></td></tr>
            }
            </tbody></table></div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="app-card card-pad h-100">
            <div class="section-title mb-3">Durum Özeti</div>
            <div class="d-grid gap-3">
                <div class="d-flex justify-content-between"><span class="text-muted">Yeni kayıt</span><strong>@Model.Open</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Serviste</span><strong>@Model.InService</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Beklemede</span><strong>@Model.Waiting</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Teslime hazır</span><strong>@Model.Ready</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Tamamlanan / İade</span><strong>@Model.Completed</strong></div>
                <hr class="my-1" />
                <div class="d-flex justify-content-between"><span class="text-muted">Garantili ürün</span><strong>@Model.UnderWarranty</strong></div>
            </div>
        </div>
    </div>
</div>
