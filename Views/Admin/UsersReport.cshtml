@model IReadOnlyList<AyazTekServis.Models.User>
@{Layout=null;}
<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kullanıcı Raporu</title><style>body{font-family:Arial,sans-serif;margin:28px;color:#182133;font-size:12px}.toolbar{display:flex;gap:10px;margin-bottom:18px}.toolbar button{padding:9px 14px;border:1px solid #ccd4df;background:#fff;border-radius:7px}.toolbar .primary{background:#182133;color:#fff}.head{border-bottom:3px solid #182133;padding-bottom:12px;margin-bottom:15px}.report-logo{width:245px;max-width:100%;height:auto;max-height:none;object-fit:contain;display:block;margin-bottom:8px}table{width:100%;border-collapse:collapse}th,td{padding:8px;border:1px solid #dfe4ec;text-align:left}th{background:#f4f6f9;font-size:10px;text-transform:uppercase}@@media print{.toolbar{display:none}body{margin:10mm}}</style></head><body><div class="toolbar"><button class="primary" onclick="window.print()">PDF Kaydet / Yazdır</button><button onclick="history.length>1?history.back():location.href='/Admin/Users'">Kapat</button></div><div class="head"><h1>Kullanıcı Raporu</h1><div>@DateTime.Now.ToString("dd.MM.yyyy HH:mm") · @Model.Count kullanıcı</div></div><table><thead><tr><th>ID</th><th>Kullanıcı</th><th>E-posta</th><th>Durum</th><th>Rol</th><th>Kayıt</th><th>Son Giriş</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.Id</td><td>@u.Username</td><td>@u.Email</td><td>@(u.IsActive?"Aktif":"Pasif")</td><td>@(u.IsAdmin?"Admin":"Kullanıcı")</td><td>@u.CreatedAt.ToString("dd.MM.yyyy")</td><td>@(u.LastLoginAt?.ToString("dd.MM.yyyy HH:mm")??"-")</td></tr>}</tbody></table></body></html>