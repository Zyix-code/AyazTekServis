@model IReadOnlyList<AyazTekServis.Models.ErrorLog>
@{ViewData["Title"]="Hata Logları";var pg=(int)(ViewBag.Page??1);var pages=(int)(ViewBag.TotalPages??1);}
<div class="page-head"><div><div class="eyebrow">Sistem</div><h1>Hata Logları</h1><p>Uygulamada oluşan yakalanmamış hatalar yalnızca yöneticilere gösterilir.</p></div><form asp-action="ClearErrorLogs" method="post" onsubmit="return confirm('Tüm hata logları silinsin mi?');">@Html.AntiForgeryToken()<button class="btn btn-outline-danger"><i class="bi bi-trash3 me-1"></i>Logları Temizle</button></form></div>
<div class="app-card overflow-hidden"><div class="app-table-scroll"><table class="table mb-0 service-table"><thead><tr><th class="ps-4">Tarih</th><th>Kullanıcı</th><th>İstek</th><th>Hata</th><th>Mesaj</th><th class="pe-4">Detay</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="6" class="text-center py-5 text-muted">Hata kaydı yok.</td></tr>}@foreach(var e in Model){<tr class="error-log-row"><td class="ps-4 text-nowrap">@e.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</td><td>@e.Username<br><small>@e.IpAddress</small></td><td><code>@e.Method @e.Path</code></td><td><span class="badge text-bg-danger"><i class="bi bi-bug-fill me-1"></i>@e.ExceptionType.Split('.').Last()</span></td><td>@e.Message</td><td class="pe-4"><details><summary>Stack</summary><pre class="small mt-2">@e.StackTrace</pre></details></td></tr>}</tbody></table></div>@if(pages>1){<div class="pagination-bar"><small>Sayfa @pg / @pages</small><div class="d-flex gap-2"><a asp-action="ErrorLogs" asp-route-page="@(pg-1)" class="btn btn-sm btn-outline-secondary @(pg<=1?"disabled":"")">Önceki</a><a asp-action="ErrorLogs" asp-route-page="@(pg+1)" class="btn btn-sm btn-outline-secondary @(pg>=pages?"disabled":"")">Sonraki</a></div></div>}</div>
