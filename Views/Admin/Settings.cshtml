@{ ViewData["Title"]="Sistem Ayarları"; }
<div class="page-head compact-page-head"><div><div class="eyebrow">Admin</div><h1>Sistem Ayarları</h1><p>Temel uygulama, e-posta ve haftalık rapor ayarlarını yönetin.</p></div></div>
<div class="settings-grid-clean">
<div class="app-card overflow-hidden"><form asp-action="Settings" method="post">@Html.AntiForgeryToken()
<section class="form-section"><div class="section-title">Genel Ayarlar</div><div class="row g-3 mt-1"><div class="col-md-6"><label class="form-label fw-bold">Şirket / Uygulama Adı</label><input name="companyName" value="@ViewBag.CompanyName" class="form-control"/></div><div class="col-md-6"><label class="form-label fw-bold">Destek E-postası</label><input name="supportEmail" value="@ViewBag.SupportEmail" type="email" class="form-control"/></div><div class="col-12"><label class="form-label fw-bold">Dış Erişim Adresi</label><input name="publicBaseUrl" value="@ViewBag.PublicBaseUrl" type="url" class="form-control" placeholder="https://servis.ornekfirma.com"/><small class="text-muted">Şifre sıfırlama bağlantıları bu adres üzerinden oluşturulur.</small></div><div class="col-12"><label class="form-label fw-bold">Varsayılan Tema</label><select name="defaultTheme" class="form-select"><option value="system" selected="@(ViewBag.DefaultTheme=="system")">Sistem ayarını kullan</option><option value="light" selected="@(ViewBag.DefaultTheme=="light")">Açık</option><option value="dark" selected="@(ViewBag.DefaultTheme=="dark")">Koyu</option></select></div></div></section>
<section class="form-section"><div class="section-title">E-posta Sunucusu</div><div class="row g-3 mt-1"><div class="col-md-8"><label class="form-label fw-bold">SMTP Host</label><input name="smtpHost" value="@ViewBag.SmtpHost" class="form-control"/></div><div class="col-md-4"><label class="form-label fw-bold">Port</label><input name="smtpPort" value="@ViewBag.SmtpPort" inputmode="numeric" class="form-control"/></div><div class="col-md-6"><label class="form-label fw-bold">SMTP Kullanıcı</label><input name="smtpUsername" value="@ViewBag.SmtpUsername" class="form-control"/></div><div class="col-md-6"><label class="form-label fw-bold">Gönderen Adresi</label><input name="smtpFrom" value="@ViewBag.SmtpFrom" type="email" class="form-control"/></div><div class="col-12"><label class="form-label fw-bold">SMTP Parolası</label><input name="smtpPassword" type="password" autocomplete="new-password" class="form-control" placeholder="@(ViewBag.SmtpPasswordConfigured==true?"Parola kayıtlı · değiştirmek için yeni parola girin":"SMTP parolasını girin")"/><small class="text-muted">Boş bırakırsanız mevcut parola değişmez.</small></div><div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="smtpEnableSsl" value="true" id="smtpSsl" checked="@(ViewBag.SmtpEnableSsl=="true")"/><label class="form-check-label fw-bold" for="smtpSsl">SSL/TLS kullan</label></div></div></div></section>
<section class="form-section"><div class="section-title">Haftalık Rapor</div><div class="section-sub mb-3">Her pazartesi sabahı aktif adminlere ve aşağıdaki adreslere servis Excel raporu ile veritabanı yedeği gönderilir.</div><label class="form-label fw-bold">Yönetici / Şirket E-posta Adresleri</label><textarea name="weeklyReportRecipients" rows="3" class="form-control" placeholder="yonetici@firma.com">@ViewBag.WeeklyReportRecipients</textarea><small class="text-muted">Birden fazla adresi virgül veya noktalı virgülle ayırabilirsiniz.</small></section>
<div class="p-4 text-end"><button class="btn btn-primary px-5 fw-bold"><i class="bi bi-save"></i><span>Ayarları Kaydet</span></button></div></form></div>
<div class="settings-side-stack"><div class="app-card card-pad"><div class="section-title">E-posta Durumu</div><p class="text-muted mb-3">Durum: <strong class="@(ViewBag.SmtpConfigured==true?"text-success":"text-warning")">@(ViewBag.SmtpConfigured==true?"Gönderime hazır":"Parola bekleniyor")</strong></p><form asp-action="TestEmail" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-primary w-100"><i class="bi bi-send-check"></i><span>Test E-postası Gönder</span></button></form></div><div class="app-card card-pad"><div class="section-title mb-2">Veritabanı Yedeği</div><p class="text-muted">İsterseniz haftalık rapor dışında manuel yedek de alabilirsiniz.</p><form asp-action="Backup" method="post">@Html.AntiForgeryToken()<button class="btn btn-dark w-100 fw-bold"><i class="bi bi-database-down"></i><span>Şimdi Yedek Al</span></button></form></div></div>
</div>
