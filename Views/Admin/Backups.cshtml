@model IReadOnlyList<AyazTekServis.Models.BackupHistory>
@{ViewData["Title"]="Veritabanı Yedekleri";var last=ViewBag.LastSuccessful as AyazTekServis.Models.BackupHistory;}
<div class="page-head"><div><div class="eyebrow">Güvenlik</div><h1>Veritabanı Yedekleri</h1><p>Başarılı ve başarısız yedek işlemlerinin geçmişi.</p></div><form asp-action="Backup" method="post">@Html.AntiForgeryToken()<button class="btn btn-dark"><i class="bi bi-database-down me-2"></i>Şimdi Yedek Al</button></form></div>
@if(last==null||last.CreatedAt<DateTime.Now.AddDays(-7)){<div class="alert alert-warning app-alert"><i class="bi bi-exclamation-triangle-fill"></i><div><strong>Yedek gecikmiş durumda.</strong><div>@(last==null?"Henüz başarılı yedek yok.":$"Son başarılı yedek {(DateTime.Now-last.CreatedAt).Days} gün önce alındı.")</div></div></div>}
<div class="app-card overflow-hidden"><div class="app-table-scroll"><table class="table mb-0"><thead><tr><th class="ps-4">Tarih</th><th>Kullanıcı</th><th>Dosya</th><th>Boyut</th><th>Durum</th><th class="pe-4">İşlem</th></tr></thead><tbody>@foreach(var b in Model){<tr><td class="ps-4">@b.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td><td>@b.Username</td><td>@b.FileName</td><td>@(b.SizeBytes>0?$"{b.SizeBytes/1024d/1024d:N2} MB":"-")</td><td><span class="badge @(b.IsSuccessful?"text-bg-success":"text-bg-danger")">@(b.IsSuccessful?"Başarılı":"Hata")</span>@if(!b.IsSuccessful&&!string.IsNullOrWhiteSpace(b.ErrorMessage)){<small class="d-block text-danger mt-1">@b.ErrorMessage</small>}</td><td class="pe-4">@if(b.IsSuccessful){<a asp-action="DownloadBackup" asp-route-fileName="@b.FileName" class="btn btn-sm btn-outline-primary"><i class="bi bi-download me-1"></i>İndir</a>}</td></tr>}</tbody></table></div></div>
