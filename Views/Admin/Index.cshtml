@using AyazTekServis.Models
@{
    ViewData["Title"] = "Admin Paneli";
    var logs = ViewBag.RecentLogs as IReadOnlyList<AuditLog> ?? new List<AuditLog>();
    var backup = ViewBag.LastBackup as BackupHistory;
    var overdue = (bool)(ViewBag.BackupOverdue ?? true);
}
<div class="page-head">
    <div><div class="eyebrow">Yönetim Merkezi</div><h1>Admin Paneli</h1><p>Yönetim araçları ayrı bölümlere ayrıldı; günlük işler ve sistem kayıtları birbirine karışmaz.</p></div>
</div>
@if(overdue){<div class="alert alert-warning app-alert"><i class="bi bi-database-exclamation"></i><div class="flex-grow-1"><strong>Yedekleme uyarısı</strong><div>@(backup==null?"Henüz başarılı bir veritabanı yedeği alınmadı.":$"Son başarılı yedek {(DateTime.Now-backup.CreatedAt).Days} gün önce alındı.")</div></div><a asp-action="Backups" class="btn btn-sm btn-warning">Yedeklere Git</a></div>}

<div class="admin-stat-grid mb-4">
    <a asp-action="Users" class="admin-stat-card"><span><strong>@ViewBag.UserCount</strong><small>Kullanıcı</small></span><i class="bi bi-people"></i></a>
    <a asp-action="Sessions" class="admin-stat-card"><span><strong>@ViewBag.ActiveSessionCount</strong><small>Aktif Oturum</small></span><i class="bi bi-display"></i></a>
    <a asp-action="DeletedRecords" class="admin-stat-card"><span><strong>@ViewBag.DeletedServiceCount</strong><small>Silinen Kayıt</small></span><i class="bi bi-trash3"></i></a>
    <a asp-action="ErrorLogs" class="admin-stat-card"><span><strong>@ViewBag.ErrorCount24h</strong><small>24 Saatte Hata</small></span><i class="bi bi-bug"></i></a>
</div>

<div class="app-card card-pad mb-4">
    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3"><div><div class="section-title">Yönetim Araçları</div><div class="section-sub">İhtiyacınız olan bölüme doğrudan gidin.</div></div></div>
    <div class="admin-tool-grid">
        <a asp-action="Users" class="admin-tool"><i class="bi bi-people"></i><span><strong>Kullanıcılar</strong><small>Hesap, rol, kullanıcı raporları</small></span></a>
        <a asp-action="Logs" class="admin-tool"><i class="bi bi-activity"></i><span><strong>İşlem Logları</strong><small>Sistem ve kullanıcı hareketleri</small></span></a>
        <a asp-action="SendEmail" class="admin-tool"><i class="bi bi-envelope"></i><span><strong>E-posta</strong><small>Kayıtlı veya manuel alıcı</small></span></a>
        <a asp-action="Sessions" class="admin-tool"><i class="bi bi-display"></i><span><strong>Aktif Oturumlar</strong><small>Girişleri görüntüle ve kapat</small></span></a>
        <a asp-action="Backups" class="admin-tool"><i class="bi bi-database-check"></i><span><strong>Yedekler</strong><small>Yedek oluştur, indir ve geçmişi gör</small></span></a>
        <a asp-action="DeletedRecords" class="admin-tool"><i class="bi bi-trash3"></i><span><strong>Silinen Kayıtlar</strong><small>Geri yükle veya kalıcı sil</small></span></a>
        <a asp-action="ErrorLogs" class="admin-tool"><i class="bi bi-bug"></i><span><strong>Hata Logları</strong><small>Uygulama hatalarını incele</small></span></a>
        <a asp-action="Settings" class="admin-tool"><i class="bi bi-sliders"></i><span><strong>Sistem Ayarları</strong><small>Tema ve e-posta ayarları</small></span></a>
    </div>
    <div class="admin-export-row mt-3 pt-3 border-top">
        <a asp-controller="Service" asp-action="ExportExcel" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-2"></i>Servis Excel</a>
        <a asp-controller="Service" asp-action="AllReport" target="_blank" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-2"></i>Servis PDF</a>
        <a asp-action="ExportUsersExcel" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-2"></i>Kullanıcı Excel</a>
        <a asp-action="UsersReport" target="_blank" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-2"></i>Kullanıcı PDF</a>
    </div>
</div>

<div class="app-card overflow-hidden">
    <div class="card-pad d-flex justify-content-between align-items-center gap-2 border-bottom flex-wrap"><div><div class="section-title">Son İşlemler</div><div class="section-sub">Son 12 sistem hareketi</div></div><a asp-action="Logs" class="btn btn-sm btn-outline-primary">Tüm Loglar</a></div>
    <div class="table-responsive admin-recent-table-wrap"><table class="table align-middle mb-0 admin-recent-table"><thead><tr><th>Tarih</th><th>Kullanıcı</th><th>İşlem</th><th>Açıklama</th></tr></thead><tbody>
    @if(!logs.Any()){<tr><td colspan="4" class="text-center text-muted py-5">Henüz log bulunmuyor.</td></tr>}
    @foreach(var l in logs){var danger=l.Action.Contains("Hata",StringComparison.OrdinalIgnoreCase)||l.Action.Contains("Kalıcı",StringComparison.OrdinalIgnoreCase);var warning=l.Action.Contains("Sil",StringComparison.OrdinalIgnoreCase)||l.Action.Contains("Uyarı",StringComparison.OrdinalIgnoreCase);<tr><td class="text-nowrap">@l.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td><td><strong>@l.Username</strong></td><td><span class="log-pill @(danger?"danger":warning?"warning":"success")">@l.Action</span></td><td class="admin-log-description">@l.Description</td></tr>}
    </tbody></table></div>
</div>
