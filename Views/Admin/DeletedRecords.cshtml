@model IReadOnlyList<AyazTekServis.Models.ServiceRecord>
@{ViewData["Title"]="Silinen Kayıt Geçmişi";var pg=(int)(ViewBag.Page??1);var pages=(int)(ViewBag.TotalPages??1);}
<div class="page-head"><div><div class="eyebrow">Soft Delete</div><h1>Silinen Kayıt Geçmişi</h1><p>Silinen servis kayıtları, silen kullanıcı ve silinme tarihi.</p></div></div>
<div class="app-card overflow-hidden"><div class="app-table-scroll"><table class="table mb-0 service-table"><thead><tr><th class="ps-4">Takip No</th><th>Ürün</th><th>Seri No</th><th>Silen</th><th>Silinme Tarihi</th><th class="pe-4">İşlem</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="6" class="text-center py-5 text-muted">Çöp kutusu boş.</td></tr>}@foreach(var r in Model){<tr><td class="ps-4"><strong>@r.TrackingNumber</strong></td><td>@r.Brand @r.Model</td><td><code>@r.SerialNumber</code></td><td>@r.DeletedByUsername</td><td>@r.DeletedAt?.ToString("dd.MM.yyyy HH:mm")</td><td class="pe-4"><div class="d-flex gap-2"><form asp-controller="Service" asp-action="Restore" asp-route-id="@r.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-success">Geri Yükle</button></form><form asp-controller="Service" asp-action="PermanentDelete" asp-route-id="@r.Id" method="post" onsubmit="return confirm('Kalıcı silinsin mi?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-danger">Kalıcı Sil</button></form></div></td></tr>}</tbody></table></div>@if(pages>1){<div class="pagination-bar"><small>Sayfa @pg / @pages</small><div class="d-flex gap-2"><a asp-action="DeletedRecords" asp-route-page="@(pg-1)" class="btn btn-sm btn-outline-secondary @(pg<=1?"disabled":"")">Önceki</a><a asp-action="DeletedRecords" asp-route-page="@(pg+1)" class="btn btn-sm btn-outline-secondary @(pg>=pages?"disabled":"")">Sonraki</a></div></div>}</div>
