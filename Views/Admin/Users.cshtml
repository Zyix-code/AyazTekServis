@model IReadOnlyList<AyazTekServis.Models.User>
@{
    ViewData["Title"]="Kullanıcı Yönetimi";
    var currentPage=(int)(ViewBag.Page??1);
    var totalPages=(int)(ViewBag.TotalPages??1);
    var pageSize=(int)(ViewBag.PageSize??20);
    var total=(int)(ViewBag.Total??Model.Count);
}
<div class="page-head"><div><div class="eyebrow">Admin · Kullanıcı Yönetimi</div><h1>Kullanıcılar</h1><p>Hesap durumlarını, rollerini ve güvenlik işlemlerini yönetin.</p></div><div class="d-flex flex-wrap gap-2"><a asp-action="ExportUsersExcel" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a><a asp-action="UsersReport" target="_blank" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a><a asp-action="SendEmail" class="btn btn-primary"><i class="bi bi-envelope me-1"></i>E-posta</a></div></div>
<div class="app-card card-pad mb-4"><form method="get" class="row g-2 align-items-end"><div class="col-xl-5 col-lg-4"><label class="form-label small fw-bold">Arama</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Kullanıcı adı veya e-posta ara..."/></div><div class="col-xl-2 col-lg-2"><label class="form-label small fw-bold">Durum</label><select name="state" class="form-select"><option value="">Tüm durumlar</option><option value="active" selected="@(ViewBag.State=="active")">Aktif</option><option value="passive" selected="@(ViewBag.State=="passive")">Pasif</option></select></div><div class="col-xl-2 col-lg-2"><label class="form-label small fw-bold">Rol</label><select name="role" class="form-select"><option value="">Tüm roller</option><option value="admin" selected="@(ViewBag.Role=="admin")">Admin</option><option value="user" selected="@(ViewBag.Role=="user")">Kullanıcı</option></select></div><div class="col-xl-1 col-lg-2"><label class="form-label small fw-bold">Sayfa</label><select name="pageSize" class="form-select"><option value="20" selected="@(pageSize==20)">20</option><option value="50" selected="@(pageSize==50)">50</option><option value="100" selected="@(pageSize==100)">100</option></select></div><div class="col-xl-2 col-lg-2 d-flex gap-2"><button class="btn btn-dark flex-fill">Filtrele</button><a asp-action="Users" class="btn btn-outline-secondary" title="Temizle"><i class="bi bi-x-lg"></i></a></div></form></div>
<div class="app-card overflow-hidden">
<div class="list-toolbar"><div><strong>@total</strong> kullanıcı</div><div class="text-muted">Sayfa @currentPage / @totalPages</div></div>
<div class="table-responsive app-table-scroll"><table class="table align-middle mb-0 admin-users-table"><thead><tr><th class="ps-4">Kullanıcı</th><th>Kayıt / Son Giriş</th><th class="text-center">Aktif</th><th class="text-center">Admin</th><th class="text-center">Yetki Kaydet</th><th class="text-end pe-4">İşlemler</th></tr></thead><tbody>
@if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-5">Kullanıcı bulunamadı.</td></tr>}
@foreach(var u in Model){
    var formId = $"userRoleForm_{u.Id}";
    <tr>
        <td class="ps-4"><div class="user-cell"><span class="user-avatar">@(string.IsNullOrWhiteSpace(u.Username) ? "?" : u.Username.Substring(0,1).ToUpperInvariant())</span><div class="min-w-0"><strong class="text-truncate">@u.Username</strong><small class="text-truncate">@u.Email</small></div></div></td>
        <td><small class="d-block">Kayıt: <strong>@u.CreatedAt.ToString("dd.MM.yyyy")</strong></small><small class="d-block text-muted">Son giriş: @(u.LastLoginAt?.ToString("dd.MM.yyyy HH:mm")??"-")</small></td>
        <td class="text-center"><div class="form-check form-switch d-inline-flex m-0"><input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@u.IsActive" form="@formId" aria-label="@u.Username aktif"/></div></td>
        <td class="text-center"><div class="form-check form-switch d-inline-flex m-0"><input class="form-check-input" type="checkbox" name="isAdmin" value="true" checked="@u.IsAdmin" form="@formId" aria-label="@u.Username admin"/></div></td>
        <td class="text-center"><form id="@formId" asp-action="UpdateUser" method="post" class="m-0">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"/><button class="btn btn-sm btn-outline-primary px-3"><i class="bi bi-check2 me-1"></i>Kaydet</button></form></td>
        <td class="text-end pe-4"><div class="d-inline-flex flex-wrap justify-content-end gap-2"><a asp-action="Logs" asp-route-username="@u.Username" class="btn btn-sm btn-outline-secondary" title="Kullanıcının işlem logları"><i class="bi bi-clock-history me-1"></i>Loglar</a><a asp-action="ExportUserExcel" asp-route-id="@u.Id" class="btn btn-sm btn-outline-success" title="Kullanıcı Excel raporu"><i class="bi bi-file-earmark-excel"></i></a><a asp-action="UserReport" asp-route-id="@u.Id" target="_blank" class="btn btn-sm btn-outline-danger" title="Kullanıcı PDF raporu"><i class="bi bi-file-earmark-pdf"></i></a><a asp-action="SendEmail" asp-route-userId="@u.Id" class="btn btn-sm btn-outline-primary" title="E-posta gönder"><i class="bi bi-envelope"></i></a><form asp-action="SendPasswordReset" asp-route-id="@u.Id" method="post" class="m-0">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-warning" title="Şifre sıfırlama maili"><i class="bi bi-key"></i></button></form><form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="m-0" onsubmit="return confirm('Bu kullanıcı kalıcı olarak silinsin mi?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" title="Kullanıcıyı sil"><i class="bi bi-trash3"></i></button></form></div></td>
    </tr>
}
</tbody></table></div>
@if(totalPages>1){<div class="pagination-bar"><small class="text-muted">@total kullanıcı · @pageSize kayıt/sayfa</small><nav aria-label="Kullanıcı sayfalama"><ul class="pagination pagination-sm mb-0"><li class="page-item @(currentPage<=1?"disabled":"")"><a class="page-link" asp-action="Users" asp-route-search="@ViewBag.Search" asp-route-state="@ViewBag.State" asp-route-role="@ViewBag.Role" asp-route-pageSize="@pageSize" asp-route-page="@(currentPage-1)">Önceki</a></li><li class="page-item disabled"><span class="page-link">@currentPage / @totalPages</span></li><li class="page-item @(currentPage>=totalPages?"disabled":"")"><a class="page-link" asp-action="Users" asp-route-search="@ViewBag.Search" asp-route-state="@ViewBag.State" asp-route-role="@ViewBag.Role" asp-route-pageSize="@pageSize" asp-route-page="@(currentPage+1)">Sonraki</a></li></ul></nav></div>}
</div>
