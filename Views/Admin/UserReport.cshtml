@model AyazTekServis.Models.User
@using AyazTekServis.Models
@{Layout=null;var logs=ViewBag.Logs as IReadOnlyList<AuditLog>??new List<AuditLog>();}
<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@Model.Username Kullanıcı Raporu</title><style>body{font-family:Arial,sans-serif;margin:28px;color:#182133;font-size:12px}.toolbar{display:flex;gap:10px;margin-bottom:18px}.toolbar button{padding:9px 14px;border:1px solid #ccd4df;background:#fff;border-radius:7px}.toolbar .primary{background:#182133;color:#fff}.head{border-bottom:3px solid #182133;padding-bottom:12px;margin-bottom:15px}.profile{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:16px}.item{border:1px solid #dfe4ec;border-radius:7px;padding:9px}.item small{display:block;color:#6f7888;margin-bottom:3px}table{width:100%;border-collapse:collapse}th,td{padding:7px;border:1px solid #dfe4ec;text-align:left}th{background:#f4f6f9;font-size:10px;text-transform:uppercase}@@media print{.toolbar{display:none}body{margin:10mm}.profile{grid-template-columns:repeat(2,1fr)}}</style></head><body><div class="toolbar"><button class="primary" onclick="window.print()">PDF Kaydet / Yazdır</button><button onclick="history.length>1?history.back():location.href='/Admin/Users'">Kapat</button></div><div class="head"><h1>@Model.Username · Kullanıcı Raporu</h1><div>@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</div></div><div class="profile"><div class="item"><small>E-posta</small><strong>@Model.Email</strong></div><div class="item"><small>Durum</small><strong>@(Model.IsActive?"Aktif":"Pasif")</strong></div><div class="item"><small>Rol</small><strong>@(Model.IsAdmin?"Admin":"Kullanıcı")</strong></div><div class="item"><small>Son Giriş</small><strong>@(Model.LastLoginAt?.ToString("dd.MM.yyyy HH:mm")??"-")</strong></div></div><table><thead><tr><th>Tarih</th><th>İşlem</th><th>Varlık</th><th>Açıklama</th></tr></thead><tbody>@if(!logs.Any()){<tr><td colspan="4">İşlem kaydı bulunmuyor.</td></tr>}@foreach(var l in logs){var changes=AyazTekServis.Services.AuditChangeFormatter.DescribeInline(l.OldValues,l.NewValues);<tr><td>@l.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td><td>@l.Action</td><td>@l.EntityType @l.EntityId</td><td>@l.Description@if(!string.IsNullOrWhiteSpace(changes)){<div style="margin-top:4px;font-size:10px;color:#5d6878">@changes</div>}</td></tr>}</tbody></table></body></html>