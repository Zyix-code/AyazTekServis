@model IReadOnlyList<AyazTekServis.Models.ServiceRecord>
@{ViewData["Title"]="Cihaz Geçmişi";}
<div class="page-head"><div><div class="eyebrow">Seri Numarası</div><h1>Cihaz Geçmişi</h1><p><code>@ViewBag.SerialNumber</code> seri numaralı cihazın geçmiş servis kayıtları.</p></div><a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Kayıtlara Dön</a></div>
<div class="app-card overflow-hidden"><div class="app-table-scroll"><table class="table table-hover align-middle mb-0 service-table"><thead><tr><th class="ps-4">Tarih</th><th>Takip No</th><th>Ürün</th><th>Arıza</th><th>Yapılan İşlem</th><th>Durum</th><th>Kaydı Açan</th><th class="pe-4"></th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="8" class="text-center py-5 text-muted">Bu seri numarası için servis geçmişi bulunamadı.</td></tr>}@foreach(var r in Model){<tr><td class="ps-4 text-nowrap">@r.CreatedAt.ToString("dd.MM.yyyy")</td><td><strong>@r.TrackingNumber</strong></td><td>@r.Brand @r.Model</td><td>@r.FaultReason</td><td>@(string.IsNullOrWhiteSpace(r.ServiceResult)?"-":r.ServiceResult)</td><td><span class="badge text-bg-light border">@r.Status</span></td><td>@r.CreatedByUsername</td><td class="pe-4"><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-right"></i></a></td></tr>}</tbody></table></div></div>
