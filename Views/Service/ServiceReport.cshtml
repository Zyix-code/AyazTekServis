@model AyazTekServis.Models.ServiceRecord
@{
    Layout = null;
    var autoPrint = ViewBag.AutoPrint == true;
    var fromCreate = ViewBag.FromCreate == true;
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Servis Kayıt Formu - @Model.TrackingNumber</title>
    <link rel="stylesheet" href="~/css/customer-report.css" asp-append-version="true" />
</head>
<body data-detail-url="@Url.Action("Details", "Service", new { id = Model.Id })" data-from-create="@(fromCreate ? "true" : "false")" data-auto-print="@(autoPrint ? "true" : "false")">
    <div class="report-tools">
        <span class="report-hint">PDF için yazdırma ayarlarında “Üstbilgiler ve altbilgiler” seçeneğini kapatın.</span>
        <button type="button" class="report-button primary" data-report-print>PDF Kaydet / Yazdır</button>
        <button type="button" class="report-button" data-report-close>Kapat</button>
    </div>
    <main class="report-sheet">
        <header class="report-head">
            <img class="report-logo" src="~/images/ayaz-teknoloji-logo.jpg" alt="Ayaz Teknoloji" />
            <div class="report-headline"><h1>SERVİS KAYIT FORMU</h1><p>Ürün kabul ve teknik servis kaydı</p></div>
            <div class="report-contact"><strong>AYAZ TEKNOLOJİ</strong>Mecidiyeköy Mah., Şht. Ahmet Sok. No:4 K:5<br />34387 Şişli / İstanbul<br />(0212) 217 95 96</div>
        </header>
        <div class="report-meta" style="--meta-cols:3">
            <div><span class="report-label">AyazTek Fiş No</span><strong class="report-value report-code">@Model.TrackingNumber</strong></div>
            <div><span class="report-label">Kayıt Tarihi</span><strong class="report-value">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</strong></div>
            <div><span class="report-label">Garanti</span><strong class="report-value">@(Model.IsUnderWarranty ? "Garantili" : "Garantisiz")</strong></div>
        </div>
        <section class="report-section">
            <h2>Müşteri Bilgileri</h2>
            <div class="report-fields">
                <div class="report-field span-2"><span class="report-label">Gönderen / Müşteri</span><strong class="report-value">@Model.Sender</strong></div>
                <div class="report-field span-2"><span class="report-label">Telefon</span><strong class="report-value">@(string.IsNullOrWhiteSpace(Model.CustomerPhone) ? "Belirtilmemiş" : Model.CustomerPhone)</strong></div>
            </div>
        </section>
        <section class="report-section">
            <h2>Ürün Bilgileri</h2>
            <div class="report-fields">
                <div class="report-field"><span class="report-label">Marka</span><strong class="report-value">@Model.Brand</strong></div>
                <div class="report-field"><span class="report-label">Model</span><strong class="report-value">@Model.Model</strong></div>
                <div class="report-field"><span class="report-label">Ürün Cinsi</span><strong class="report-value">@Model.ProductType</strong></div>
                <div class="report-field"><span class="report-label">Seri Numarası</span><strong class="report-value">@Model.SerialNumber</strong></div>
                <div class="report-field span-4"><span class="report-label">Teslim Alınan Aksesuarlar</span><strong class="report-value">@(string.IsNullOrWhiteSpace(Model.Accessories) ? "Belirtilmemiş" : Model.Accessories)</strong></div>
            </div>
        </section>
        <section class="report-section">
            <h2>Müşterinin Bildirdiği Arıza / Şikâyet</h2>
            <div class="report-message">@(string.IsNullOrWhiteSpace(Model.FaultReason) ? "Belirtilmemiş" : Model.FaultReason)</div>
        </section>
        <section class="report-terms">
            <h2>Ürün Kabul Bilgilendirmesi</h2>
            <ul>
                <li>Bu form, belirtilen cihazın ve listelenen aksesuarların teknik servis kaydına alındığını gösterir.</li>
                <li>Arızanın kesin nedeni ve yapılacak işlem teknik kontrol sonrasında netleşebilir; müşterinin bildirdiği arıza yukarıda yer alır.</li>
                <li>İşlem öncesinde önemli verilerin yedeklenmesi önerilir. Veri işlemleri hakkında ayrıca bilgilendirme ve gerekli onaylar alınmalıdır.</li>
                <li>Onarım, ücret ve teslim koşulları hakkında müşteriye ayrıca bilgi verilir.</li>
            </ul>
        </section>
        <div class="report-signatures">
            <div class="report-signature">SERVİSE BIRAKAN<small>Ad Soyad · İmza</small></div>
            <div class="report-signature">TESLİM ALAN<small>Ad Soyad · İmza</small></div>
        </div>
        <footer class="report-footer">AYAZ TEKNOLOJİ · SERVİS KAYIT FORMU · @Model.TrackingNumber</footer>
    </main>
    <script src="~/js/customer-report.js" asp-append-version="true"></script>
</body>
</html>
