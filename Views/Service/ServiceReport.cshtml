@model AyazTekServis.Models.ServiceRecord
@{ Layout=null; var autoPrint=ViewBag.AutoPrint==true; var fromCreate=ViewBag.FromCreate==true; }
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Servis Kayıt Formu - @Model.TrackingNumber</title>
<style>
:root{--ink:#162233;--muted:#657184;--line:#cfd9e1;--soft:#f5f8fa;--brand:#13778d}*{box-sizing:border-box}html,body{margin:0;padding:0}body{background:#edf2f5;color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.4}.toolbar{width:min(210mm,calc(100% - 20px));margin:12px auto 8px;display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap}.toolbar button{border:1px solid #c9d4dc;background:#fff;color:var(--ink);border-radius:8px;padding:10px 15px;font-weight:700;cursor:pointer}.toolbar .primary{background:var(--brand);border-color:var(--brand);color:#fff}.print-hint{margin-right:auto;align-self:center;color:var(--muted);font-size:11px}.sheet{width:min(210mm,calc(100% - 20px));min-height:297mm;margin:0 auto 18px;background:#fff;padding:10mm 11mm 9mm;box-shadow:0 10px 28px rgba(20,35,50,.10);display:flex;flex-direction:column}.head{display:grid;grid-template-columns:165px 1fr 165px;align-items:center;gap:14px;padding-bottom:12px;border-bottom:2px solid var(--brand)}.head img{width:158px;height:auto;display:block}.head-center{text-align:center}.head h1{margin:0;font-size:25px;letter-spacing:.05em}.head p{margin:5px 0 0;color:var(--muted);font-size:11px}.head-contact{text-align:right;font-size:11px;line-height:1.5}.head-contact strong{display:block;color:var(--brand);font-size:12px;margin-bottom:3px}.meta{display:grid;grid-template-columns:1fr 1fr 1fr;margin-top:12px;border:1px solid var(--line)}.meta>div{padding:10px 11px;text-align:center;border-right:1px solid var(--line)}.meta>div:last-child{border-right:0}.lbl{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:3px}.meta strong{font-size:13px}.tracking{color:var(--brand);font-size:17px!important}.section{margin-top:12px}.section-title{margin-bottom:6px;font-size:12px;font-weight:800;color:var(--brand);text-transform:uppercase;letter-spacing:.05em}.grid{width:100%;border-collapse:collapse;table-layout:fixed}.grid td,.grid th{border:1px solid var(--line);padding:9px 10px;vertical-align:top;overflow-wrap:anywhere}.grid th{background:var(--soft);font-size:10px;text-transform:uppercase;text-align:left}.cell-label{display:block;color:var(--muted);font-size:9.5px;text-transform:uppercase;margin-bottom:3px}.grid strong{font-size:13px}.text-box{border:1px solid var(--line);padding:10px 11px;min-height:52px;white-space:pre-wrap;overflow-wrap:anywhere;font-weight:700;font-size:13px}.terms{margin-top:12px;border:1px solid #b9d8de;background:#f7fbfc;padding:10px 12px}.terms h2{font-size:12px;margin:0 0 6px;color:var(--brand)}.terms ul{margin:0;padding-left:18px}.terms li{margin:3px 0;font-size:10.4px;line-height:1.32}.signatures{display:grid;grid-template-columns:1fr 1fr;gap:58px;margin-top:auto;padding-top:26px}.signature{text-align:center;padding-top:22px;border-top:1px solid #67717e;font-weight:700;font-size:11px}.signature small{display:block;color:var(--muted);font-weight:400;margin-top:3px}.doc-footer{text-align:center;color:var(--muted);font-size:9.5px;margin-top:10px;padding-top:7px;border-top:1px solid var(--line)}
@@media(max-width:720px){body{font-size:12px}.sheet{width:calc(100% - 12px);min-height:auto;padding:16px}.head{grid-template-columns:1fr;text-align:center}.head img{margin:auto}.head-contact{text-align:center}.meta{grid-template-columns:1fr}.meta>div{border-right:0;border-bottom:1px solid var(--line)}.meta>div:last-child{border-bottom:0}.grid,.grid tbody,.grid tr,.grid td{display:block;width:100%}.signatures{gap:24px}.toolbar{width:calc(100% - 12px)}.toolbar button{flex:1}.print-hint{width:100%;text-align:center}}
@@media print{@@page{size:A4;margin:0}html,body{width:210mm;height:297mm;background:#fff;-webkit-print-color-adjust:exact;print-color-adjust:exact}.toolbar{display:none!important}.sheet{width:210mm;height:297mm;min-height:297mm;margin:0;padding:9mm 10mm 8mm;box-shadow:none;overflow:hidden}.section,.terms,.signatures{break-inside:avoid}.doc-footer{margin-top:8px}}

.head{grid-template-columns:178px minmax(0,1fr) 178px;gap:16px;padding-bottom:13px}.head img{width:174px;max-width:100%;margin:0 auto}.head-center{min-width:0}.head h1{font-size:25px;line-height:1.12}.head p{font-size:11px;line-height:1.35}.head-contact{font-size:11px;line-height:1.48}.sheet{padding:10mm 11mm 8mm}.meta>div{padding:10px 12px}.grid td,.grid th{padding:9px 10px}.signatures{padding-top:26px}.doc-footer{font-size:9.5px}
@@media(max-width:720px){.head img{width:190px;max-width:78%}.head h1{font-size:21px}.head-contact{font-size:10.5px}.sheet{padding:17px 15px}.toolbar{gap:7px}.toolbar button{min-height:40px}}
@@media print{.head{grid-template-columns:46mm minmax(0,1fr) 46mm}.head img{width:45mm}.head h1{font-size:20pt}.sheet{padding:9mm 10mm 7mm}.meta>div{padding:8px 9px}.section{margin-top:10px}.grid td,.grid th{padding:7px 8px}.text-box{padding:8px 9px}.signatures{padding-top:22px}}
</style>
</head>
<body>
<script>
function closeReport(){const fromCreate=@(fromCreate ? "true" : "false");try{if(window.opener&&!window.opener.closed){window.close();return;}}catch(e){}if(fromCreate){window.location.replace('/Service/AddService?fresh=true&v='+Date.now());return;}window.location.replace('/Service/Details/@Model.Id');}
function printReport(){const old=document.title;document.title='';window.print();setTimeout(()=>document.title=old,500);}
</script>
<div class="toolbar"><span class="print-hint">Yazdırma penceresinde “Üstbilgiler ve altbilgiler” kapalı olmalıdır.</span><button class="primary" type="button" onclick="printReport()">PDF Kaydet / Yazdır</button><button type="button" onclick="closeReport()">Kapat</button></div>
<main class="sheet">
<header class="head">
  <img src="/images/ayaz-teknoloji-logo.jpg" alt="Ayaz Teknoloji">
  <div class="head-center"><h1>SERVİS KAYIT FORMU</h1><p>ÜRÜN KABUL VE TEKNİK SERVİS KAYDI</p></div>
  <div class="head-contact"><strong>AYAZ TEKNOLOJİ</strong>Mecidiyeköy Mah., Şht. Ahmet Sok. No:4 K:5<br>34387 Şişli / İstanbul<br>(0212) 217 95 96</div>
</header>
<section class="meta"><div><span class="lbl">Servis Takip No</span><strong class="tracking">@Model.TrackingNumber</strong></div><div><span class="lbl">Servis Kayıt Tarihi</span><strong>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</strong></div><div><span class="lbl">Garanti Durumu</span><strong>@(Model.IsUnderWarranty?"GARANTİLİ":"GARANTİSİZ")</strong></div></section>
<section class="section"><div class="section-title">Müşteri / Gönderen</div><table class="grid"><tr><td><span class="cell-label">Gönderen / Müşteri</span><strong>@(string.IsNullOrWhiteSpace(Model.Sender)?"-":Model.Sender)</strong></td><td><span class="cell-label">Telefon</span><strong>@(string.IsNullOrWhiteSpace(Model.CustomerPhone)?"-":Model.CustomerPhone)</strong></td><td><span class="cell-label">E-posta</span><strong>@(string.IsNullOrWhiteSpace(Model.CustomerEmail)?"-":Model.CustomerEmail)</strong></td></tr></table></section>
<section class="section"><div class="section-title">Ürün Bilgileri</div><table class="grid"><tr><td><span class="cell-label">Marka</span><strong>@Model.Brand</strong></td><td><span class="cell-label">Model</span><strong>@Model.Model</strong></td><td><span class="cell-label">Cins</span><strong>@Model.ProductType</strong></td><td><span class="cell-label">Seri No</span><strong>@Model.SerialNumber</strong></td></tr><tr><td colspan="2"><span class="cell-label">Gönderilen Servis / Teknik Birim</span><strong>@(string.IsNullOrWhiteSpace(Model.SentToService)?"-":Model.SentToService)</strong></td><td colspan="2"><span class="cell-label">Aksesuar</span><strong>@(string.IsNullOrWhiteSpace(Model.Accessories)?"-":Model.Accessories)</strong></td></tr></table></section>
<section class="section"><div class="section-title">Arıza / Şikayet</div><div class="text-box">@(string.IsNullOrWhiteSpace(Model.FaultReason)?"-":Model.FaultReason)</div></section>
@if(!string.IsNullOrWhiteSpace(Model.Notes)){<section class="section"><div class="section-title">Kayıt Notu</div><div class="text-box">@Model.Notes</div></section>}
@if(Model.Parts.Any()){<section class="section"><div class="section-title">Parça Bilgileri</div><table class="grid"><thead><tr><th>Parça Adı</th><th>Seri No</th><th style="width:65px">Adet</th></tr></thead><tbody>@foreach(var p in Model.Parts){<tr><td><strong>@p.PartName</strong></td><td>@(string.IsNullOrWhiteSpace(p.SerialNumber)?"-":p.SerialNumber)</td><td>@p.Quantity</td></tr>}</tbody></table></section>}
<section class="terms"><h2>SERVİSE TESLİM VE KABUL ŞARTLARI</h2><ul><li>Servis formu ibraz edilmeden ürün teslimi yapılamaz.</li><li>Arıza tespiti en az 2, en çok 7 iş günüdür; servise gönderilen ürünlerde azami servis süresi 20 iş günüdür.</li><li>Müşteri işlem öncesinde verilerinin yedeğini almakla sorumludur; veri kaybı ve işletim sistemi sorunlarından şirket sorumlu değildir.</li><li>Yazılım lisanslarının yasal sorumluluğu kullanıcıya aittir; lisanssız yazılım kurulumu yapılmaz.</li><li>Zamanında teslim alınmayan ürünlerden doğabilecek saklama risklerinden şirket sorumlu tutulamaz.</li></ul></section>
<section class="signatures"><div class="signature">TESLİM EDEN / SERVİSE BIRAKAN<small>Ad Soyad · İmza</small></div><div class="signature">TESLİM ALAN<small>Ad Soyad · İmza</small></div></section>
<footer class="doc-footer">AYAZ TEKNOLOJİ · SERVİS KAYIT FORMU · @Model.TrackingNumber</footer>
</main>
@if(autoPrint){<script>window.addEventListener('load',()=>setTimeout(printReport,250));</script>}
</body></html>
