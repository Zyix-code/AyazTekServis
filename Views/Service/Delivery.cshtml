@model AyazTekServis.Models.ServiceRecord
@{ ViewData["Title"]="Ürün Teslimi"; }
<div class="page-head"><div><div class="eyebrow">3 / 3 · Teslim</div><h1>Ürün Teslimi</h1><p><strong>@Model.TrackingNumber</strong> numaralı kaydın teslim bilgilerini tamamlayın.</p></div><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Detaya Dön</a></div>
<div class="workflow-steps mb-4"><div class="workflow-step done"><span><i class="bi bi-check-lg"></i></span><div><strong>Kayıt</strong><small>Tamamlandı</small></div></div><div class="workflow-line done"></div><div class="workflow-step done"><span><i class="bi bi-check-lg"></i></span><div><strong>Kontrol</strong><small>Kaydedildi</small></div></div><div class="workflow-line done"></div><div class="workflow-step active"><span>3</span><div><strong>Teslim</strong><small>Kapanış</small></div></div></div>
<form asp-action="Delivery" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/>
<div class="row g-4"><div class="col-xl-7"><div class="app-card overflow-hidden"><section class="form-section"><div class="section-title">Teslim Bilgileri</div><div class="section-sub mb-3">Teslim yöntemini ve gerçekleşen teslim tarihini kaydedin.</div><div class="row g-3">
<div class="col-md-6"><label class="form-label fw-bold">Teslim Şekli *</label><select name="deliveryMethod" class="form-select" required><option value="Müşteriye Teslim" selected="@(Model.DeliveryMethod=="Müşteriye Teslim" ? "selected" : null)">Müşteriye Teslim</option><option value="Kargo" selected="@(Model.DeliveryMethod=="Kargo" ? "selected" : null)">Kargo</option></select><div class="invalid-feedback">Bu alanın seçilmesi zorunludur.</div></div>
<div class="col-md-6"><label class="form-label fw-bold">Teslim Tarihi *</label><input type="date" name="deliveryDate" value="@((Model.DeliveryDate ?? DateTime.Today).ToString("yyyy-MM-dd"))" class="form-control" required/><div class="invalid-feedback">Bu alanın doldurulması zorunludur.</div></div>
</div></section></div></div>
<div class="col-xl-5">
    <div class="app-card card-pad delivery-review-card">
        <div class="section-title mb-2">Teslim Öncesi Kontrol</div>
        <div class="section-sub mb-3">Müşteriye verilecek teslim formundaki bilgileri kontrol edin.</div>
        <div class="delivery-outcome-pill mb-3">Servis sonucu: <strong>@Model.Status</strong></div>
        <div class="summary-list">
            <div><span>Ürün</span><strong>@Model.Brand @Model.Model</strong></div>
            <div><span>Seri No</span><strong>@Model.SerialNumber</strong></div>
            <div><span>Bildirilen Arıza</span><strong>@Model.FaultReason</strong></div>
            <div><span>Yapılan İşlem / Sonuç</span><strong>@(string.IsNullOrWhiteSpace(Model.ServiceResult) ? "Sonuç girilmemiş" : Model.ServiceResult)</strong></div>
            <div><span>Garanti</span><strong>@(Model.IsUnderWarranty ? "Garantili" : "Garantisiz")</strong></div>
            @if (Model.HasCharge && Model.ChargeAmount.HasValue && Model.ChargeAmount.Value > 0)
            {
                <div><span>Servis Ücreti</span><strong>@Model.ChargeAmount.Value.ToString("N2") @Model.ChargeCurrency · @Model.ChargeVatMode</strong></div>
            }
        </div>
        <div class="d-grid gap-2 mt-3">
            <button type="submit" class="btn btn-success fw-bold"><i class="bi bi-box-arrow-right me-1"></i> Teslimi Tamamla</button>
            <a asp-action="Control" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Kontrol Bilgilerini Düzenle</a>
        </div>
        <small class="text-muted d-block mt-2">Onarılamadı ve müşteri onaylamadı sonuçları teslimden sonra korunur.</small>
    </div>
</div>
</div></form>
