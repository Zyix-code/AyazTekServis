@model AyazTekServis.Models.ServiceRecord
@{ ViewData["Title"]="Ürün Teslimi"; }
<div class="page-head"><div><div class="eyebrow">3 / 3 · Teslim</div><h1>Ürün Teslimi</h1><p><strong>@Model.TrackingNumber</strong> · @Model.Brand @Model.Model</p></div><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Detaya Dön</a></div>
<div class="workflow-steps mb-4"><div class="workflow-step done"><span><i class="bi bi-check-lg"></i></span><div><strong>Kayıt</strong><small>Tamamlandı</small></div></div><div class="workflow-line done"></div><div class="workflow-step done"><span><i class="bi bi-check-lg"></i></span><div><strong>Kontrol</strong><small>Kaydedildi</small></div></div><div class="workflow-line done"></div><div class="workflow-step active"><span>3</span><div><strong>Teslim</strong><small>Kapanış</small></div></div></div>
<form asp-action="Delivery" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/>
<div class="row g-4"><div class="col-xl-7"><div class="app-card overflow-hidden"><section class="form-section"><div class="section-title">Teslim Bilgileri</div><div class="section-sub mb-3">Teknik bilgiler burada tekrar girilmez; yalnızca teslimi kapatın.</div><div class="row g-3">
<div class="col-md-6"><label class="form-label fw-bold">Teslim Şekli *</label><select name="deliveryMethod" class="form-select"><option value="Müşteriye Teslim" selected="@(Model.DeliveryMethod=="Müşteriye Teslim")">Müşteriye Teslim</option><option value="Kargo" selected="@(Model.DeliveryMethod=="Kargo")">Kargo</option></select></div>
<div class="col-md-6"><label class="form-label fw-bold">Teslim Tarihi *</label><input type="date" name="deliveryDate" value="@((Model.DeliveryDate ?? DateTime.Today).ToString("yyyy-MM-dd"))" class="form-control" required/></div>
</div></section></div></div>
<div class="col-xl-5"><div class="app-card card-pad"><div class="section-title mb-3">Teslim Öncesi Özet</div><div class="summary-list"><div><span>Yapılan İşlem</span><strong>@(string.IsNullOrWhiteSpace(Model.ServiceResult)?"Kontrol sonucu girilmedi":Model.ServiceResult)</strong></div><div><span>Garanti</span><strong>@(Model.IsUnderWarranty?"Garantili":"Garantisiz")</strong></div></div><hr/><button class="btn btn-success w-100 fw-bold py-2"><i class="bi bi-box-arrow-right me-1"></i> Teslimi Tamamla</button><small class="text-muted d-block mt-2 text-center">Kaydın durumu “Tamamlandı” olarak işaretlenir.</small></div></div></div></form>
