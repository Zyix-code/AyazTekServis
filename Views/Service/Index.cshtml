@inject AyazTekServis.Services.BusinessDayService BusinessDays
@model IReadOnlyList<AyazTekServis.Models.ServiceRecord>
@{
    ViewData["Title"] = "Servis Kayıtları";
    var statuses = ViewBag.Statuses as string[] ?? Array.Empty<string>();
    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var total = (int)(ViewBag.Total ?? Model.Count);
    var totalAll = (int)(ViewBag.TotalAll ?? total);
    var activeCount = (int)(ViewBag.ActiveCount ?? 0);
    var completedCount = (int)(ViewBag.CompletedCount ?? 0);
    var inServiceCount = (int)(ViewBag.InServiceCount ?? 0);
    var waitingPartCount = (int)(ViewBag.WaitingPartCount ?? 0);
    var openCount = (int)(ViewBag.OpenCount ?? 0);
    var readyCount = (int)(ViewBag.ReadyCount ?? 0);
    var completedDividerShown = false;
}

<div class="page-head service-page-head">
    <div>
        <div class="eyebrow">Servis Yönetimi</div>
        <h1>Servis Kayıtları</h1>
        <p>Servis kayıtlarını görüntüleyin, filtreleyin ve ilgili işleme hızlıca geçin.</p>
    </div>
    <div class="d-flex flex-wrap gap-2 service-page-actions">
        <a asp-action="ExportExcel" class="btn btn-outline-success px-3 py-2 fw-semibold"><i class="bi bi-file-earmark-excel me-2"></i>Tümünü Excel</a>
        <a asp-action="AllReport" target="_blank" class="btn btn-outline-danger px-3 py-2 fw-semibold"><i class="bi bi-file-earmark-pdf me-2"></i>Tümünü PDF</a>
        <a asp-action="AddService" class="btn btn-primary px-4 py-2 fw-bold"><i class="bi bi-plus-lg me-2"></i>Yeni Kayıt</a>
    </div>
</div>

<div class="service-summary-grid mb-4">
    <div class="service-summary-card summary-total"><span class="summary-icon"><i class="bi bi-collection"></i></span><div><strong>@totalAll</strong><small>Toplam Kayıt</small></div></div>
    <div class="service-summary-card summary-active"><span class="summary-icon"><i class="bi bi-activity"></i></span><div><strong>@activeCount</strong><small>Aktif Kayıt</small></div></div>
    <div class="service-summary-card summary-service"><span class="summary-icon"><i class="bi bi-tools"></i></span><div><strong>@inServiceCount</strong><small>Serviste / Onarımda</small></div></div>
    <div class="service-summary-card summary-part"><span class="summary-icon"><i class="bi bi-box-seam"></i></span><div><strong>@waitingPartCount</strong><small>Parça Bekliyor</small></div></div>
    <div class="service-summary-card summary-open"><span class="summary-icon"><i class="bi bi-folder-plus"></i></span><div><strong>@openCount</strong><small>Kayıt Açıldı</small></div></div>
    <div class="service-summary-card summary-ready"><span class="summary-icon"><i class="bi bi-check2-circle"></i></span><div><strong>@readyCount</strong><small>Teslime Hazır</small></div></div>
    <div class="service-summary-card summary-completed"><span class="summary-icon"><i class="bi bi-archive"></i></span><div><strong>@completedCount</strong><small>Tamamlanan</small></div></div>
</div>

<div class="app-card card-pad service-filter-card mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-xl-4 col-lg-5"><label class="form-label small fw-bold">Arama</label><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Servis no, gönderen, ürün veya seri no" /></div></div>
        <div class="col-xl-2 col-lg-3"><label class="form-label small fw-bold">Durum</label><select name="status" class="form-select"><option value="">Tümü</option>@foreach(var s in statuses){<option value="@s" selected="@(ViewBag.Status == s ? "selected" : null)">@s</option>}</select></div>
        <div class="col-xl-2 col-lg-2"><label class="form-label small fw-bold">Garanti</label><select name="warranty" class="form-select"><option value="">Tümü</option><option value="yes" selected="@(ViewBag.Warranty == "yes" ? "selected" : null)">Garantili</option><option value="no" selected="@(ViewBag.Warranty == "no" ? "selected" : null)">Garantisiz</option></select></div>
        <div class="col-xl-2 col-lg-2"><label class="form-label small fw-bold">Sayfa</label><select name="pageSize" class="form-select"><option value="20" selected="@(pageSize == 20 ? "selected" : null)">20</option><option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option><option value="100" selected="@(pageSize == 100 ? "selected" : null)">100</option></select></div>
        <div class="col-xl-2 col-lg-3"><label class="form-label small fw-bold">Para Birimi</label><select name="currency" class="form-select"><option value="">Tümü</option><option value="TRY" selected="@(ViewBag.Currency == "TRY" ? "selected" : null)">TRY</option><option value="USD" selected="@(ViewBag.Currency == "USD" ? "selected" : null)">USD</option><option value="EUR" selected="@(ViewBag.Currency == "EUR" ? "selected" : null)">EUR</option></select></div>
        <div class="col-xl-2 col-lg-3"><label class="form-label small fw-bold">Başlangıç</label><input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="form-control" /></div>
        <div class="col-xl-2 col-lg-3"><label class="form-label small fw-bold">Bitiş</label><input type="date" name="dateTo" value="@ViewBag.DateTo" class="form-control" /></div>
        @if(User.IsInRole("Admin")){<div class="col-xl-3 col-lg-3"><div class="form-check form-switch service-deleted-switch"><input class="form-check-input" type="checkbox" name="showDeleted" value="true" id="showDeleted" checked="@(ViewBag.ShowDeleted == true ? "checked" : null)"/><label class="form-check-label" for="showDeleted">Silinenleri göster</label></div></div>}
        <div class="col-xl-3 col-lg-3 ms-auto d-flex gap-2 service-filter-actions"><button class="btn btn-dark flex-fill"><i class="bi bi-funnel me-1"></i>Filtrele</button><a asp-action="Index" class="btn btn-outline-secondary" title="Filtreleri temizle"><i class="bi bi-x-lg"></i></a></div>
    </form>
</div>

<div class="app-card service-list-card">
    <div class="service-table-wrap" id="serviceTableWrap">
        <table class="table table-hover align-middle mb-0 service-table" id="serviceTable">
            <colgroup>
                <col class="col-service-no" />
                <col class="col-sender" />
                <col class="col-product" />
                <col class="col-warranty" />
                <col class="col-status" />
                <col class="col-duration" />
                <col class="col-actions" />
            </colgroup>
            <thead>
                <tr>
                    <th class="ps-3 service-no-col">Servis No</th>
                    <th>Gönderen</th>
                    <th>Ürün</th>
                    <th>Garanti / Ücret</th>
                    <th>Durum</th>
                    <th>Servis Süresi</th>
                    <th class="text-end pe-3 service-actions-col">İşlem</th>
                </tr>
            </thead>
            <tbody>
            @if(!Model.Any()){
                <tr class="service-empty-row"><td colspan="7" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-2 d-block mb-2"></i>Kriterlere uygun kayıt bulunamadı.</td></tr>
            }
            @foreach(var item in Model){
                var isCompleted = item.DeliveryDate.HasValue || item.Status == "Tamamlandı";
                var statusClass = item.Status switch
                {
                    "Parça Bekliyor" => "status-part",
                    "Serviste" => "status-service",
                    "Onarımda" => "status-repair",
                    "Müşteri Onayı Bekliyor" => "status-approval",
                    "Beklemede" => "status-waiting",
                    "Teslime Hazır" => "status-ready",
                    "İade Bekliyor" => "status-returned",
                    "Müşteri Onaylamadı" => "status-approval",
                    "Tamamlandı" => "status-completed",
                    "İade Edildi" => "status-returned",
                    "Onarılamadı" => "status-unrepairable",
                    _ => "status-open"
                };
                if(isCompleted && !completedDividerShown){
                    completedDividerShown = true;
                    <tr class="service-section-divider"><td colspan="7"><span><i class="bi bi-archive me-2"></i>Teslim Edilmiş / Sonuçlanmış Kayıtlar</span></td></tr>
                }
                var lastUser = string.IsNullOrWhiteSpace(item.UpdatedByUsername) ? item.CreatedByUsername : item.UpdatedByUsername;
                var lastTime = item.UpdatedAt ?? item.CreatedAt;
                var days = BusinessDays.Count(item);
                var lvl = BusinessDays.Level(item);
                var serviceDescription = BusinessDays.Describe(item);
                <tr class="service-row @(item.IsDeleted ? "opacity-50" : "") @(isCompleted ? "service-row-completed" : "service-row-active")" title="Son işlem: @lastTime.ToString("dd.MM.yyyy HH:mm") · @lastUser">
                    <td class="ps-3 service-no-col" data-label="Servis No">
                        <strong class="service-track text-primary">@item.TrackingNumber</strong>
                        <small class="service-secondary-line">Servis Fiş No: @(string.IsNullOrWhiteSpace(item.ServiceReceiptNumber) ? "Fiş numarası girilmemiş" : item.ServiceReceiptNumber)</small>
                        <small class="service-secondary-line">@item.CreatedAt.ToString("dd.MM.yyyy")</small>
                    </td>
                    <td data-label="Gönderen" class="service-sender-cell">
                        <strong class="service-primary-line service-sender-line" title="@(string.IsNullOrWhiteSpace(item.Sender) ? "-" : item.Sender)">@(string.IsNullOrWhiteSpace(item.Sender) ? "-" : item.Sender)</strong>
                        @if(!string.IsNullOrWhiteSpace(item.SentToService)){<small class="service-secondary-line" title="@item.SentToService">@item.SentToService</small>}
                    </td>
                    <td data-label="Ürün" class="service-product-cell">
                        <strong class="service-primary-line service-product-line" title="@item.Brand @item.Model">@item.Brand @item.Model</strong>
                        <small class="service-secondary-line" title="@item.ProductType">@item.ProductType</small>
                        @if(!string.IsNullOrWhiteSpace(item.SerialNumber)){<small class="service-serial-line" title="Seri No: @item.SerialNumber"><span class="service-serial-tag">SN</span><span class="service-serial-value">@item.SerialNumber</span></small>}
                    </td>
                    <td data-label="Garanti / Ücret" class="service-warranty-cell">
                        <span class="badge @(item.IsUnderWarranty ? "text-bg-success" : "text-bg-secondary")">@(item.IsUnderWarranty ? "Garantili" : "Garantisiz")</span>
                        @if(item.HasCharge){var cur=item.ChargeCurrency=="TRY"?"TL":item.ChargeCurrency;var vat=string.IsNullOrWhiteSpace(item.ChargeVatMode)?"KDV Hariç":item.ChargeVatMode;var vatText=vat=="KDV Hariç"?"+ KDV":vat=="KDV Yok"?"KDV Yok":"KDV Dahil";<small class="service-charge-line">@item.ChargeAmount?.ToString("N2") @cur @vatText</small>}
                    </td>
                    <td data-label="Durum">@if(item.IsDeleted){<span class="badge text-bg-danger">Silindi</span>}else{<span class="status-badge @statusClass">@item.Status</span>}</td>
                    <td data-label="Servis Süresi"><span class="duration-chip duration-@lvl" title="@serviceDescription">@days iş günü</span></td>
                    <td class="text-end pe-3 service-actions-col" data-label="İşlem">
                        <div class="service-action-buttons">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Detay"><i class="bi bi-eye"></i></a>
                            @if(!item.IsDeleted){
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></a>
                            }else if(User.IsInRole("Admin")){
                                <form asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-success" title="Geri yükle"><i class="bi bi-arrow-counterclockwise"></i></button></form>
                                <form asp-action="PermanentDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kayıt kalıcı olarak silinecek. Bu işlem geri alınamaz. Devam edilsin mi?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-danger" title="Kalıcı sil"><i class="bi bi-trash3-fill"></i></button></form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if(totalPages > 1){
        <div class="pagination-bar service-pagination">
            <small class="text-muted">Sayfa @currentPage / @totalPages</small>
            <nav aria-label="Servis kayıtları sayfalama"><ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-warranty="@ViewBag.Warranty" asp-route-currency="@ViewBag.Currency" asp-route-dateFrom="@ViewBag.DateFrom" asp-route-dateTo="@ViewBag.DateTo" asp-route-showDeleted="@ViewBag.ShowDeleted" asp-route-pageSize="@pageSize" asp-route-page="@(currentPage-1)">Önceki</a></li>
                <li class="page-item disabled"><span class="page-link">@currentPage / @totalPages</span></li>
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-warranty="@ViewBag.Warranty" asp-route-currency="@ViewBag.Currency" asp-route-dateFrom="@ViewBag.DateFrom" asp-route-dateTo="@ViewBag.DateTo" asp-route-showDeleted="@ViewBag.ShowDeleted" asp-route-pageSize="@pageSize" asp-route-page="@(currentPage+1)">Sonraki</a></li>
            </ul></nav>
        </div>
    }
</div>
