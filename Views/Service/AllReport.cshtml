@model IReadOnlyList<AyazTekServis.Models.ServiceRecord>
@{Layout=null;}
<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tüm Servis Kayıtları</title>
<style>body{font-family:Arial,sans-serif;margin:24px;color:#172033;font-size:11px}.toolbar{display:flex;gap:10px;margin-bottom:18px}.toolbar button{padding:9px 14px;border:1px solid #ccd4df;background:#fff;border-radius:7px;cursor:pointer}.toolbar .primary{background:#172033;color:white}.head{display:flex;justify-content:space-between;align-items:end;border-bottom:3px solid #172033;padding-bottom:12px;margin-bottom:16px}.report-logo{width:245px;max-width:100%;height:auto;max-height:none;object-fit:contain;display:block;margin-bottom:4px}h1{margin:0;font-size:22px}.muted{color:#6c7687}.summary{margin-bottom:12px}.table-wrap{width:100%;overflow:hidden}table{width:100%;border-collapse:collapse;table-layout:fixed}th,td{border:1px solid #dfe4eb;padding:6px;vertical-align:top;word-break:break-word}th{background:#f3f5f8;font-size:9px;text-transform:uppercase}.status{font-weight:700}@@media print{.toolbar{display:none}body{margin:8mm;font-size:9px}tr{break-inside:avoid}}</style></head><body>
<div class="toolbar"><button class="primary" onclick="window.print()">PDF Kaydet / Yazdır</button><button onclick="history.length>1?history.back():location.href='/Service'">Kapat</button></div>
<div class="head"><div><div class="muted">TÜM SERVİS KAYITLARI RAPORU</div></div><div class="muted">@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</div></div>
<div class="summary"><strong>@Model.Count</strong> aktif servis kaydı</div>
<table><thead><tr><th>Takip No</th><th>Tarih</th><th>Gönderen</th><th>Müşteri E-posta</th><th>Telefon</th><th>Ürün</th><th>Seri No</th><th>Servis</th><th>Arıza</th><th>Durum</th><th>Garanti</th><th>Sonuç</th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.TrackingNumber</td><td>@x.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td><td>@(string.IsNullOrWhiteSpace(x.Sender)?"-":x.Sender)</td><td>@(string.IsNullOrWhiteSpace(x.CustomerEmail)?"-":x.CustomerEmail)</td><td>@(string.IsNullOrWhiteSpace(x.CustomerPhone)?"-":x.CustomerPhone)</td><td>@x.Brand @x.Model<br><span class="muted">@x.ProductType</span></td><td>@x.SerialNumber</td><td>@x.SentToService</td><td>@x.FaultReason</td><td class="status">@x.Status</td><td>@(x.IsUnderWarranty?"Garantili":"Garantisiz")</td><td>@(string.IsNullOrWhiteSpace(x.ServiceResult)?"-":x.ServiceResult)</td></tr>}
</tbody></table></body></html>