@model AyazTekServis.Models.ServiceRecord
@{
    ViewData["Title"] = "Yapılan İşlemi Düzenle";
    var currentResult = ViewBag.EditedResult as string ?? Model.ServiceResult ?? string.Empty;
    var delivered = Model.Status == "Tamamlandı" && Model.DeliveryDate.HasValue;
}
<div class="page-head">
    <div>
        <div class="eyebrow">@Model.TrackingNumber</div>
        <h1>Yapılan İşlemi Düzenle</h1>
        <p>Eksik veya hatalı teknik işlem açıklamasını güncelleyin.</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Detaya Dön</a>
</div>
<div class="app-card card-pad" style="max-width:900px">
    @if(delivered)
    {
        <div class="alert alert-info">Bu ürün müşteriye teslim edilmiştir. Burada yalnızca yapılan işlem açıklaması düzeltilir; teslim tarihi ve tamamlanmış kayıt durumu değişmez. Daha önce verilmiş veya indirilmiş formlar otomatik güncellenmez.</div>
    }
    <form asp-action="EditServiceResult" asp-route-id="@Model.Id" method="post" novalidate>
        @Html.AntiForgeryToken()
        <label for="serviceResult" class="form-label fw-bold">Yapılan İşlem / Teknik Sonuç</label>
        <textarea id="serviceResult" name="serviceResult" class="form-control @(ViewData.ModelState[nameof(Model.ServiceResult)]?.Errors.Count > 0 || ViewData.ModelState["serviceResult"]?.Errors.Count > 0 ? "is-invalid" : "")" rows="9" maxlength="6000" required>@currentResult</textarea>
        <div class="invalid-feedback">Bu alanın doldurulması zorunludur.</div>
        <span class="text-danger small" asp-validation-for="ServiceResult"></span>
        @if(ViewData.ModelState["serviceResult"]?.Errors.Count > 0)
        {
            <div class="text-danger small mt-1">@ViewData.ModelState["serviceResult"]!.Errors[0].ErrorMessage</div>
        }
        <div class="form-text">Mevcut metni düzeltebilir veya yeni yapılan işlemleri sonuna ekleyebilirsiniz. Önceki sürümler işlem geçmişinde saklanır.</div>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Vazgeç</a>
        </div>
    </form>
</div>
