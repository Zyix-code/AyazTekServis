@model AyazTekServis.Models.ServiceRecord
@{
    Layout = null;
    var hasCharge = Model.HasCharge && Model.ChargeAmount.HasValue && Model.ChargeAmount.Value > 0;
    var currencyLabel = Model.ChargeCurrency switch { "TRY" => "₺", "EUR" => "€", "USD" => "$", _ => Model.ChargeCurrency };
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ürün Teslim Formu - @Model.TrackingNumber</title>
    <link rel="stylesheet" href="~/css/customer-report.css" asp-append-version="true" />
</head>
<body data-detail-url="@Url.Action("Details", "Service", new { id = Model.Id })">
    <div class="report-tools">
        <span class="report-hint">PDF için yazdırma ayarlarında “Üstbilgiler ve altbilgiler” seçeneğini kapatın.</span>
        <button type="button" class="report-button primary" data-report-print>PDF Kaydet / Yazdır</button>
        <button type="button" class="report-button" data-report-close>Kapat</button>
    </div>
    <main class="report-sheet">
        <header class="report-head">
            <img class="report-logo" src="~/images/ayaz-teknoloji-logo.jpg" alt="Ayaz Teknoloji" />
            <div class="report-headline"><h1>ÜRÜN TESLİM FORMU</h1><p>Teknik servis sonuç ve teslim tutanağı</p></div>
            <div class="report-contact"><strong>AYAZ TEKNOLOJİ</strong>Mecidiyeköy Mah., Şht. Ahmet Sok. No:4 K:5<br />34387 Şişli / İstanbul<br />(0212) 217 95 96</div>
        </header>
        <div class="report-meta" style="--meta-cols:3">
            <div><span class="report-label">AyazTek Fiş No</span><strong class="report-value report-code">@Model.TrackingNumber</strong></div>
            <div><span class="report-label">Teslim Tarihi</span><strong class="report-value">@(Model.DeliveryDate?.ToString("dd.MM.yyyy") ?? "-")</strong></div>
            <div><span class="report-label">Teslim Şekli</span><strong class="report-value">@Model.DeliveryMethod</strong></div>
        </div>
        <section class="report-section">
            <h2>Müşteri Bilgileri</h2>
            <div class="report-fields">
                <div class="report-field span-2"><span class="report-label">Gönderen / Müşteri</span><strong class="report-value">@Model.Sender</strong></div>
                <div class="report-field span-2"><span class="report-label">Telefon</span><strong class="report-value">@(string.IsNullOrWhiteSpace(Model.CustomerPhone) ? "Belirtilmemiş" : Model.CustomerPhone)</strong></div>
            </div>
        </section>
        <section class="report-section">
            <h2>Teslim Edilen Ürün</h2>
            <div class="report-fields">
                <div class="report-field"><span class="report-label">Marka</span><strong class="report-value">@Model.Brand</strong></div>
                <div class="report-field"><span class="report-label">Model</span><strong class="report-value">@Model.Model</strong></div>
                <div class="report-field"><span class="report-label">Ürün Cinsi</span><strong class="report-value">@Model.ProductType</strong></div>
                <div class="report-field"><span class="report-label">Seri Numarası</span><strong class="report-value">@Model.SerialNumber</strong></div>
                <div class="report-field span-2"><span class="report-label">Garanti Durumu</span><strong class="report-value">@(Model.IsUnderWarranty ? "Garantili" : "Garantisiz")</strong></div>
                <div class="report-field span-2"><span class="report-label">Teslim Edilen Aksesuarlar</span><strong class="report-value">@(string.IsNullOrWhiteSpace(Model.Accessories) ? "Belirtilmemiş" : Model.Accessories)</strong></div>
            </div>
        </section>
        <section class="report-section">
            <h2>Bildirilen Arıza / Şikâyet</h2>
            <div class="report-message">@(string.IsNullOrWhiteSpace(Model.FaultReason) ? "Belirtilmemiş" : Model.FaultReason)</div>
        </section>
        <section class="report-section">
            <div class="report-result-heading"><h2>Servis Sonucu / Yapılan İşlem</h2><span class="report-status">@Model.Status</span></div>
            <div class="report-message">@(string.IsNullOrWhiteSpace(Model.ServiceResult) ? "İşlem sonucu belirtilmemiş" : Model.ServiceResult)</div>
        </section>
        @if (hasCharge)
        {
            <section class="report-section">
                <h2>Servis Ücreti</h2>
                <div class="report-fields">
                    <div class="report-field span-2"><span class="report-label">Tutar</span><strong class="report-value">@(Model.ChargeAmount!.Value.ToString("N2")) @currencyLabel</strong></div>
                    <div class="report-field span-2"><span class="report-label">KDV Durumu</span><strong class="report-value">@Model.ChargeVatMode</strong></div>
                </div>
            </section>
        }
        <section class="report-terms">
            <h2>Teslim ve Kabul Beyanı</h2>
            <p>Belirtilen seri numaralı ürünü ve yukarıda yazılı aksesuarları teslim aldığımı; bildirilen arıza, servis sonucu ve varsa ücret hakkında bilgilendirildiğimi kabul ederim. Onarım yapılamayan veya müşteri tarafından onaylanmayan işlemlerin sonucu yukarıda ayrıca belirtilmiştir.</p>
        </section>
        <div class="report-signatures">
            <div class="report-signature">TESLİM EDEN<small>Ad Soyad · İmza</small></div>
            <div class="report-signature">TESLİM ALAN<small>Ad Soyad · İmza</small></div>
        </div>
        <footer class="report-footer">AYAZ TEKNOLOJİ · ÜRÜN TESLİM FORMU · @Model.TrackingNumber</footer>
    </main>
    <script src="~/js/customer-report.js" asp-append-version="true"></script>
</body>
</html>
