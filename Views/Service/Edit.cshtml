@model AyazTekServis.Models.ServiceRecord
@{ ViewData["Title"]="Kayıt Bilgilerini Düzenle"; }
<div class="page-head"><div><div class="eyebrow">@Model.TrackingNumber · Kayıt</div><h1>Kayıt Bilgilerini Düzenle</h1><p>Ürün, müşteri ve gönderim bilgilerini güncelleyin.</p></div><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Detaya Dön</a></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="serviceForm">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div><partial name="_IntakeForm" model="Model"/><div class="form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">İptal</a><button class="btn btn-primary px-5 fw-bold"><i class="bi bi-save me-1"></i> Kayıt Bilgilerini Güncelle</button></div></form>
