@{ ViewData["Title"]="Yeni Şifre"; }
<div class="auth-card auth-card-clean"><div class="auth-card-brand auth-card-brand-small"><img src="~/images/ayaz-teknoloji-logo.jpg" alt="Ayaz Teknoloji" /></div><h2 class="fw-bold mb-1">Yeni Şifre Belirle</h2><p class="text-secondary mb-4">Yeni şifrenizi belirleyin ve hesabınıza tekrar giriş yapın.</p>@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}
<form asp-action="ResetPassword" method="post">@Html.AntiForgeryToken()<input type="hidden" name="email" value="@ViewBag.Email"/><input type="hidden" name="token" value="@ViewBag.Token"/>
@if(!string.IsNullOrWhiteSpace(ViewBag.SecurityQuestion as string)){<div class="mb-3 p-3 rounded-3 bg-body-tertiary"><small class="text-muted d-block">Güvenlik Sorusu</small><strong>@ViewBag.SecurityQuestion</strong></div><div class="mb-3"><label class="form-label fw-bold">Güvenlik Cevabı</label><input name="securityAnswer" class="form-control" autocomplete="off" required/></div>}
<div class="mb-3"><label class="form-label fw-bold">Yeni Şifre</label><input name="newPassword" type="password" class="form-control" autocomplete="new-password" minlength="6" maxlength="256" required/><small class="text-secondary">En az 6 karakter; büyük/küçük harf, rakam ve özel karakter.</small></div><div class="mb-4"><label class="form-label fw-bold">Yeni Şifre Tekrar</label><input name="confirmPassword" type="password" class="form-control" autocomplete="new-password" minlength="6" maxlength="256" required/></div><button class="btn btn-primary w-100 fw-bold">Şifreyi Güncelle</button></form></div>
