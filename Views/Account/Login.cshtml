@{ ViewData["Title"]="Giriş"; }
<div class="auth-card auth-card-clean">
    <div class="auth-card-brand"><img src="~/images/ayaz-teknoloji-logo.jpg" alt="Ayaz Teknoloji" /></div>
    @if(TempData["SuccessMessage"]!=null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}
    <form asp-action="Login" method="post">@Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label fw-bold" for="loginUsername">Kullanıcı Adı</label>
            <input id="loginUsername" name="username" class="form-control form-control-lg" autocomplete="username" autocapitalize="off" spellcheck="false" required autofocus />
            <div class="invalid-feedback">Bu alanın doldurulması zorunludur.</div>
        </div>
        <div class="mb-2">
            <label class="form-label fw-bold" for="loginPassword">Şifre</label>
            <input id="loginPassword" name="password" type="password" class="form-control form-control-lg" autocomplete="current-password" required />
            <div class="invalid-feedback">Bu alanın doldurulması zorunludur.</div>
        </div>
        <div class="text-end mb-4"><a asp-action="ForgotPassword" class="small text-decoration-none">Şifremi unuttum</a></div>
        <button class="btn btn-primary btn-lg w-100 fw-bold">Giriş Yap</button>
    </form>
    <div class="auth-card-foot">Hesabınız yok mu? <a asp-action="Register">Kayıt başvurusu</a></div>
</div>
