@{ ViewData["Title"]="Şifre Sıfırlama"; var step = ViewBag.Step as int? ?? 1; }
<div class="auth-card auth-card-clean"><div class="auth-card-brand auth-card-brand-small"><img src="~/images/ayaz-teknoloji-logo.jpg" alt="Ayaz Teknoloji" /></div><h2 class="fw-bold mb-1">Şifremi Unuttum</h2><p class="text-secondary mb-4">E-posta adresinize şifre yenileme bağlantısı göndereceğiz.</p>
@if(ViewBag.Success!=null){<div class="alert alert-success">@ViewBag.Success</div>}@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}@if(TempData["WarningMessage"]!=null){<div class="alert alert-warning">@TempData["WarningMessage"]</div>}
<form asp-action="ForgotPassword" method="post">@Html.AntiForgeryToken()
<div class="mb-3"><label class="form-label fw-bold">E-posta</label>@if(step==2){<input name="email" value="@ViewBag.Email" type="email" class="form-control form-control-lg" required readonly />}else{<input name="email" value="@ViewBag.Email" type="email" class="form-control form-control-lg" required />}</div>
@if(step==2){<div class="mb-3 p-3 rounded-3 bg-body-tertiary"><small class="text-muted d-block mb-1">Güvenlik Sorusu</small><strong>@ViewBag.SecurityQuestion</strong></div><div class="mb-4"><label class="form-label fw-bold">Güvenlik Cevabı</label><input name="securityAnswer" class="form-control form-control-lg" autocomplete="off" required autofocus /></div><button class="btn btn-primary w-100 fw-bold">Doğrula ve Bağlantıyı Gönder</button>}
else{<button class="btn btn-primary w-100 fw-bold">Devam Et</button>}
</form><div class="text-center mt-4"><a asp-action="Login" class="small text-decoration-none">← Girişe dön</a></div></div>
